/* app.rc -- infamous2.exe's Windows resources: the icon (when the build made one) and the version block.
 *
 * The icon is the game's own PS3_GAME\ICON0.PNG from your disc, converted at build time by tools\make_icon.ps1 into
 * the build folder (CMakeLists.txt defines IF2_HAVE_ICON and adds that folder to the resource include path). It is
 * never committed: it is the game's artwork. Without the disc's icon the exe simply has no icon. */
#include <winver.h>

#ifdef IF2_HAVE_ICON
1 ICON "infamous2.ico"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,0,0
 PRODUCTVERSION  1,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "inFamous 2 (PC static recompilation)"
            VALUE "ProductName",      "inFamous 2 (ps3recomp)"
            VALUE "InternalName",     "infamous2"
            VALUE "OriginalFilename", "infamous2.exe"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "ProductVersion",   "1.0.0.0"
            VALUE "Comments",         "Runs your own copy of inFamous 2 (BCUS98125). Game data is never included."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
